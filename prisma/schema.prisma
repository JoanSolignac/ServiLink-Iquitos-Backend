// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id     String     @id @default(uuid())
  email  String     @unique
  role   UserRole
  status UserStatus

  authIdentities AuthIdentity[]
  devices        Device[]
  profile        Profile?
  services       Service[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  serviceRequests ServiceRequests[]
  ratings         Rating[]          @relation("CustomerRatings")

  @@map("users")
}

model Device {
  id         String   @id
  userId     String
  fcmToken   String
  lastSeenAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model AuthIdentity {
  id         String @id @default(uuid())
  userId     String
  provider   String
  providerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_identities")
}

model Profile {
  userId            String   @id
  firstName         String
  lastName          String
  birthDate         DateTime
  profilePictureUrl String?
  bio               String?
  phone             String?
  address           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum UserRole {
  USER
  MODERATOR
  ADMINISTRATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Service {
  id            String        @id @default(uuid())
  userId        String
  title         String
  description   String
  price         Decimal
  status        ServiceStatus
  keywords      String[]
  averageRating Float         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequests[]
  ratings         Rating[]

  @@map("services")
}

enum ServiceStatus {
  PENDING
  REQUIRE_REVIEW
  APPROVED
  REJECTED
}

model ServiceRequests {
  id          String               @id @default(uuid())
  serviceId   String
  customerId  String
  description String               @db.Text
  status      ServiceRequestStatus
  isRated     Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating  Rating?

  @@map("service_requests")
}

model Rating {
  id               String   @id @default(uuid())
  serviceRequestId String   @unique
  serviceId        String
  customerId       String
  score            Int
  comment          String
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequests @relation(fields: [serviceRequestId], references: [id])
  service        Service         @relation(fields: [serviceId], references: [id])
  customer       User            @relation("CustomerRatings", fields: [customerId], references: [id])

  @@map("ratings")
}

enum ServiceRequestStatus {
  PENDING
  ACCEPTED
  CANCELLED
  FINISHED
  CONFIRMED
  REJECTED
}
