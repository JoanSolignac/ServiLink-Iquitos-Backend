// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id     String     @id @default(uuid())
  email  String     @unique
  role   UserRole
  status UserStatus

  authIdentities AuthIdentity[]
  devices        Device[]
  profile        Profile?
  services       Service[]
  ratings        Rating[]       @relation("CustomerRatings")
  favorites      Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Device {
  id         String   @id
  userId     String
  fcmToken   String
  lastSeenAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model AuthIdentity {
  id         String @id @default(uuid())
  userId     String
  provider   String
  providerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_identities")
}

model Profile {
  userId            String   @id
  firstName         String
  lastName          String
  birthDate         DateTime
  profilePictureUrl String?
  bio               String?
  phone             String?  @unique
  address           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum UserRole {
  USER
  MODERATOR
  ADMINISTRATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Service {
  id            String        @id @default(uuid())
  userId        String
  title         String
  description   String
  price         Decimal?
  pricingUnit   String?
  status        ServiceStatus
  keywords      String[]
  averageRating Float         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings   Rating[]
  favorites Favorite[]

  @@map("services")
}

enum ServiceStatus {
  PENDING
  REQUIRE_REVIEW
  APPROVED
  REJECTED
}

model Rating {
  id         String   @id @default(uuid())
  serviceId  String
  customerId String
  score      Int
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  service  Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer User    @relation("CustomerRatings", fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([serviceId, customerId])
  @@map("ratings")
}

model Favorite {
  userId    String
  serviceId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId])
  @@map("favorites")
}
