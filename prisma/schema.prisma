// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id     String     @id
  email  String     @unique
  role   UserRole
  status UserStatus

  authIdentities AuthIdentity[]
  profile        Profile?
  services       Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model AuthIdentity {
  id         String @id
  userId     String
  provider   String
  providerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_identities")
}

model Profile {
  userId            String   @id
  firstName         String
  lastName          String
  birthDate         DateTime
  profilePictureUrl String?
  bio               String?
  phone             String?
  address           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum UserRole {
  USER
  MODERATOR
  ADMINISTRATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Service {
  id          String        @id
  userId      String
  title       String
  description String
  price       Decimal
  status      ServiceStatus
  keywords    String[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("services")
}

enum ServiceStatus {
  PENDING
  REQUIRE_REVIEW
  APPROVED
  REJECTED
}
