# Puerto en el que escucha el servidor
PORT=3000

# Prefijo global para las rutas de la API (ej. api/v1)
GLOBAL_PREFIX=api/v1

# Conexión a la base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/servilink

# --- Configuración de Autenticación (Auth0) ---

# Dominio del tenant de Auth0 (ej. mi-tenant.us.auth0.com)
AUTH0_DOMAIN=mi-tenant.us.auth0.com

# URL del emisor de tokens de Auth0. Debe empezar con https:// y terminar con / (ej. https://mi-tenant.us.auth0.com/)
AUTH0_ISSUER=https://mi-tenant.us.auth0.com/

# Identificador de la API configurada en Auth0 (Audience) (ej. https://api.servilink.com)
AUTH0_AUDIENCE=https://api.servilink.com

# --- Configuración de Supabase Storage ---
# URL del proyecto de Supabase (ej. https://<project-id>.supabase.co)
SUPABASE_URL=https://<project-id>.supabase.co

# Service Role Key de Supabase (mantener secreta, nunca exponer al frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nombre del bucket de Supabase Storage para archivos de perfil
SUPABASE_BUCKET_NAME=servilink-bucket

# --- Configuración de Brevo (Servicio de Envío de Correos) ---

# API Key de Brevo para autenticar el envío de correos desde la aplicación (ej. xkeysib-...)
BREVO_API_KEY=your-brevo-api-key

# Correo electrónico que se mostrará como remitente de los correos enviados
BREVO_SENDER_EMAIL=no-reply@tudominio.com

# Nombre del remitente que aparecerá al recibir los correos (ej. ServiLink)
BREVO_SENDER_NAME=ServiLink