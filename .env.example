# Puerto en el que escucha el servidor
PORT=3000

# Prefijo global para las rutas de la API (ej. api/v1)
GLOBAL_PREFIX=api/v1

# Conexión a la base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/servilink

# --- Configuración de Autenticación (Auth0) ---

# Dominio del tenant de Auth0 (ej. mi-tenant.us.auth0.com)
AUTH0_DOMAIN=mi-tenant.us.auth0.com

# URL del emisor de tokens de Auth0. Debe empezar con https:// y terminar con / (ej. https://mi-tenant.us.auth0.com/)
AUTH0_ISSUER=https://mi-tenant.us.auth0.com/

# Identificador de la API configurada en Auth0 (Audience) (ej. https://api.servilink.com)
AUTH0_AUDIENCE=https://api.servilink.com

# Credenciales de la aplicación Machine to Machine de Auth0 autorizada contra la
# Management API (scope update:users). Se usan para enviar el correo de verificación.
AUTH0_MGMT_CLIENT_ID=your-m2m-client-id
AUTH0_MGMT_CLIENT_SECRET=your-m2m-client-secret

# --- Configuración de Supabase Storage ---
# URL del proyecto de Supabase (ej. https://<project-id>.supabase.co)
SUPABASE_URL=https://<project-id>.supabase.co

# Service Role Key de Supabase (mantener secreta, nunca exponer al frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nombre del bucket de Supabase Storage para archivos de perfil
SUPABASE_BUCKET_NAME=servilink-bucket

# --- Configuración de Brevo (Servicio de Envío de Correos) ---

# API Key de Brevo para autenticar el envío de correos desde la aplicación (ej. xkeysib-...)
BREVO_API_KEY=your-brevo-api-key

# Correo electrónico que se mostrará como remitente de los correos enviados
BREVO_SENDER_EMAIL=no-reply@tudominio.com

# Nombre del remitente que aparecerá al recibir los correos (ej. ServiLink)
BREVO_SENDER_NAME=ServiLink

# --- Configuración de Firebase (Push Notifications) ---

# ID del proyecto de Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id

# Email de la cuenta de servicio de Firebase Admin SDK
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Clave privada de la cuenta de servicio (reemplazar los saltos de línea con \n)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Configuración de Stripe (Payments & Subscriptions) ---
# Clave secreta de la cuenta (modo test: sk_test_...)
STRIPE_SECRET_KEY=sk_test_...
# Firma del webhook para validar los eventos (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_...
# ID de la tarifa recurrente del plan premium (price_...)
STRIPE_PREMIUM_PRICE_ID=price_...
# (Opcional) Producto del que se resuelve dinámicamente el precio activo si
# STRIPE_PREMIUM_PRICE_ID está vacío o es "price_placeholder" (prod_...)
STRIPE_PREMIUM_PRODUCT_ID=
# Deep links de Flutter para retornar al usuario tras el checkout
STRIPE_SUCCESS_URL=servilink://checkout/success
STRIPE_CANCEL_URL=servilink://checkout/cancel
# (Opcional) URL de retorno del portal de facturación; por defecto usa STRIPE_SUCCESS_URL
STRIPE_PORTAL_RETURN_URL=